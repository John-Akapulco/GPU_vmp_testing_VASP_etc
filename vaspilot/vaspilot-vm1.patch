+def vasp_mp_calculation(calculation_id: str, work_dir: str, struct: Structure, functional: str,
+                        calc: str, attachment_path: Optional[str] = None, n_gpu: int = 1,
+                        band_gap: Optional[float] = None, incar_tags: Optional[Dict] = None) -> Dict[str, Any]:
+    """Calcul VASP avec les jeux de paramètres de Materials Project (ajout vm1-ic2mp).
+
+    functional : "pbe" (MPStaticSet / MPRelaxSet) ou "r2scan" (MPScanStaticSet / MPScanRelaxSet)
+    calc       : "sp" (point simple) ou "relax" (optimisation ISIF 3)
+    Écarts à MP : POTCAR PBE_54 (W_sv pour W), NCORE retiré (GPU), pas de WAVECAR/CHGCAR,
+    ISMEAR 0 si moins de 4 points k.
+    """
+    from pymatgen.io.vasp.sets import MPRelaxSet, MPScanRelaxSet, MPScanStaticSet, MPStaticSet
+    sets = {("pbe", "sp"): MPStaticSet, ("pbe", "relax"): MPRelaxSet,
+            ("r2scan", "sp"): MPScanStaticSet, ("r2scan", "relax"): MPScanRelaxSet}
+    functional, calc = functional.lower(), calc.lower()
+    if (functional, calc) not in sets:
+        return {"slurm_id": None, "calc_type": calc, "calculate_path": None, "success": False,
+                "error": "functional doit valoir 'pbe' ou 'r2scan', calc 'sp' ou 'relax'", "status": "failed"}
+    user_incar = {"NCORE": None, "NPAR": None, "KPAR": 1, "LWAVE": False, "LCHARG": False,
+                  "LAECHG": False, "LVTOT": False, "LVHAR": False, "LELF": False}
+    user_incar.update(incar_tags or {})
+    kwargs = dict(user_potcar_functional="PBE_54", user_potcar_settings={"W": "W_sv"})
+    if functional == "r2scan" and band_gap is not None:
+        kwargs["bandgap"] = band_gap
+    vis = sets[(functional, calc)](struct, user_incar_settings=user_incar, **kwargs)
+    if vis.kpoints is not None:
+        nk = math.prod(vis.kpoints.kpts[0])
+    else:
+        nk = math.prod(max(1, math.ceil(b / vis.incar["KSPACING"]))
+                       for b in vis.structure.lattice.reciprocal_lattice.abc)
+    if vis.incar.get("ISMEAR") == -5 and nk < 4:
+        vis = sets[(functional, calc)](struct, user_incar_settings=dict(user_incar, ISMEAR=0, SIGMA=0.05), **kwargs)
+
+    calc_dir = os.path.join(os.path.abspath(f"{work_dir}/{calculation_id}"), f"mp_{functional}_{calc}/")
+    vis.write_input(calc_dir)
+    calc_type = "relaxation" if calc == "relax" else "scf"
+    return _submit_slurm_job(calc_type, calc_dir, attachment_path, n_gpu=n_gpu)
+
+
+def _final_state_from_files(calculate_path: str) -> Optional[str]:
+    """État final d'un job d'après les fichiers écrits par slurm.sh.
+
+    Sur vm1-ic2mp la comptabilité Slurm est désactivée : sacct ne renvoie rien.
+    slurm.sh écrit le code de retour de VASP dans slurm_exit_code.
+    """
+    code_file = os.path.join(calculate_path, "slurm_exit_code")
+    if not os.path.exists(code_file):
+        return None
+    try:
+        code = int(open(code_file).read().strip() or 1)
+    except ValueError:
+        code = 1
+    outcar = os.path.join(calculate_path, "OUTCAR")
+    finished = os.path.exists(outcar) and "General timing" in open(outcar, errors="ignore").read()[-30000:]
+    return "COMPLETED" if code == 0 and finished else "FAILED"
+
+
